# ============================================
# MatchOp Scraper — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.
# ============================================

# Supabase (server-side only — service role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq AI — structured extraction
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Scraper behaviour
MATCHOP_SCRAPER_TIMEOUT=30
MATCHOP_SCRAPER_RETRIES=2
MATCHOP_SCRAPER_DELAY=2.0
MATCHOP_SCRAPER_IMPERSONATE=chrome
MATCHOP_SCRAPER_STEALTH=true

# Seed URL config path (default: ./config/seeds.yml)
MATCHOP_SEED_CONFIG_PATH=./config/seeds.yml

# Optional source-specific URL overrides (comma-separated)
MATCHOP_GREENHOUSE_URLS=
MATCHOP_LEVER_URLS=
MATCHOP_WORKABLE_URLS=
