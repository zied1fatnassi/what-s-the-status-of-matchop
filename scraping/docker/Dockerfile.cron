FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends cron \
    && rm -rf /var/lib/apt/lists/*

COPY scraping /app

RUN python -m pip install --upgrade pip \
    && pip install -e .

COPY scraping/docker/matchop-scraper.cron /etc/cron.d/matchop-scraper
RUN chmod 0644 /etc/cron.d/matchop-scraper \
    && crontab /etc/cron.d/matchop-scraper

CMD ["cron", "-f"]
