# Frontend (required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional frontend toggles
VITE_DEBUG_WEBVITALS=false
VITE_E2E_MOCK_MODE=false
VITE_SWIPE_STACK_V2=false
VITE_STANDARD_DAILY_SWIPE_LIMIT=20

# Backend ONLY (set in Supabase Dashboard secrets or CI, NOT exposed in browser)
# Do NOT prefix these with VITE_ — that would expose them to the frontend!
OPENROUTER_API_KEY=your-openrouter-key
HF_API_KEY=your-huggingface-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

