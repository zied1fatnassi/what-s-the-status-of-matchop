# ============================================
# MATCHOP Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.
# ============================================

# Frontend (exposed to browser via VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SITE_URL=https://matchop.tech

# Optional frontend toggles
VITE_DEBUG_WEBVITALS=false
VITE_E2E_MOCK_MODE=false
VITE_SWIPE_STACK_V2=false
VITE_STANDARD_DAILY_SWIPE_LIMIT=20

# Edge Functions / tooling (set in Supabase Dashboard or CI, NOT in .env)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OPENROUTER_API_KEY=your-openrouter-key
# HF_API_KEY=your-huggingface-key
